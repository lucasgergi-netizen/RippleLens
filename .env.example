# Production-shaped example. Do not put real secrets here or commit a real .env file.
PORT=8080
SPRING_PROFILES_ACTIVE=prod
H2_CONSOLE_ENABLED=false
SPRING_DATASOURCE_URL=jdbc:postgresql://db.example.com:5432/ripplelens?sslmode=require
SPRING_DATASOURCE_USERNAME=ripplelens_app
SPRING_DATASOURCE_PASSWORD=replace-with-a-long-random-password
SECURITY_AUDIT_KEY=replace-with-at-least-32-random-characters
APP_BASE_URL=https://ripplelens.onrender.com
CORS_ALLOWED_ORIGINS=https://ripplelens.onrender.com
PASSWORD_RESET_DELIVERY_ENABLED=false
PASSWORD_RESET_PROVIDER=resend
PASSWORD_RESET_FROM_ADDRESS=RippleLens <security@example.com>
RESEND_API_KEY=
NVD_API_KEY=
OPENAI_API_KEY=
NEWS_API_KEY=
METALS_DEV_API_KEY=
